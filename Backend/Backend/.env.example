# JWT Secret
Jwt__Key=your_jwt_secret_key_here

# Google OAuth Credentials
Authentication__Google__ClientId=your_google_client_id_here
Authentication__Google__ClientSecret=your_google_client_secret_here

# Email SMTP Credentials
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__Username=your_email@gmail.com
Email__Password=your_email_app_password
Email__FromEmail=your_email@gmail.com
Email__FromName=ShopVibe Store

# MoMo Payment Gateway Credentials
MoMo__PartnerCode=MOMO
MoMo__AccessKey=your_momo_access_key
MoMo__SecretKey=your_momo_secret_key
MoMo__ApiEndpoint=https://test-payment.momo.vn
MoMo__RedirectUrl=http://localhost:5173/momo-callback
MoMo__IpnUrl=https://your-domain.ngrok-free.app/api/Payment/momo/ipn

